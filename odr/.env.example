# Copy these values in when the launcher asks, or fill this file and rename it to .env
# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Tavily search key (https://app.tavily.com)
TAVILY_API_KEY=
# Loupe write key for the hosted backend (kept in your vault as "Loupe ingest key")
LOUPE_INGEST_KEY=
# Optional overrides
# LOUPE_ENDPOINT=https://loupe-y3em.onrender.com
# LOUPE_ODR_MODEL=google_genai:gemini-3.8-flash
# LOUPE_ODR_FALLBACK_MODEL=google_genai:gemini-3.1-flash-lite
# LOUPE_ODR_MAX_CONCURRENCY=2
# LOUPE_ODR_MAX_ITERATIONS=6
