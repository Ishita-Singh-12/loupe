# Variables are read from the process environment; use shell exports.
HOST=127.0.0.1
PORT=4173
# Required for persistent hosting, MongoDB 7+ (for $percentile).
MONGODB_URI=
# Protects all API routes. Production requires this key.
LOUPE_API_KEY=
# Optional JSON file with reviewed model rates. Unknown models remain unpriced.
PRICING_FILE=
# Preferred production keys, separate writer from dashboard reader.
LOUPE_INGEST_KEY=
LOUPE_READ_KEY=
# Exact browser origins, comma-separated. Empty = same-origin only.
CORS_ORIGINS=
# Only set 1 when behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Span retention by receive time. Changing requires a TTL collMod migration.
RETENTION_DAYS=30
